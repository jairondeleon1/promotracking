{
  "description": "Every day at 7am, reloads the dashboard data from the live SharePoint promotion workbook",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_sharepoint_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_workbook": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSharepointWorkbook"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync live workbook",
            "description": "Replace synced rows"
          }
        }
      }
    ]
  },
  "name": "Daily SharePoint Sync"
}